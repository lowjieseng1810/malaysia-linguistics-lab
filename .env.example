# Copy this file to `.env` and fill in real values. Never commit `.env`.

# Required. Used to sign session cookies and CSRF tokens.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-value

# Optional. Keep "false" in production. When "true", Flask shows interactive
# tracebacks and auto-reloads on file changes - never enable this on a
# publicly reachable server.
FLASK_DEBUG=false

# Optional. Use "development" for local HTTP. Use "production" on a real
# public deploy (enables Secure session cookies and blocks placeholder SECRET_KEY).
FLASK_ENV=development

# Optional. Bind host for `python app.py` (default 127.0.0.1).
# FLASK_HOST=127.0.0.1

# Optional. Absolute path to the SQLite database file.
# Leave unset locally — the app uses <project_root>/users.db.
# On Render (or any host with a persistent disk), set this to the file on
# that disk so user accounts survive redeploys. Example only (not a secret):
# DATABASE_PATH=/var/data/users.db

# Production (Render PostgreSQL). When set, the app uses Postgres instead of SQLite.
# Copy the Internal Database URL from the Render dashboard. Never commit real values.
# Example placeholder only:
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE

# --- HTTPS / reverse-proxy (production) ---
# Set both when the app sits behind Nginx/Caddy/Cloudflare terminating TLS.
# TRUST_PROXY=true lets Flask honour X-Forwarded-Proto / Host.
# FORCE_HTTPS=true redirects HTTP→HTTPS (skips localhost) and sets Secure cookies.
# TRUST_PROXY=false
# FORCE_HTTPS=false

# --- Google OAuth (optional) ---
# Production (Render): set both. Do not commit real values.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Local fallback: place google_client_secret.json in the project root (gitignored).
# Authorized redirect URIs in Google Cloud Console must include:
#   https://malaysialinguisticlab.com/login/google/callback
#   https://www.malaysialinguisticlab.com/login/google/callback
# Also set TRUST_PROXY=true and FORCE_HTTPS=true on Render so callback URLs use HTTPS.

# Optional. Enables the AI Tutor's GPT-powered answers. If unset or invalid,
# the AI Tutor automatically falls back to a deterministic "no evidence"
# message and every other feature (dictionary, quiz, favorites, progress,
# lessons, comparison, explorer) keeps working normally.
AI_TUTOR_API_KEY=

# Optional. Defaults to a reasonable model if unset. Only relevant when
# AI_TUTOR_API_KEY is set.
AI_TUTOR_MODEL=gpt-5.5

# Optional. Turns on verbose /api/tutor/debug/* diagnostics. Must be set to
# true on the SERVER and the requester must be logged in. Query-string
# (?debug=1) alone will NOT unlock these endpoints. Leave false in production.
DEBUG_TUTOR=false
